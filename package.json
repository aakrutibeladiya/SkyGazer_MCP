{
  "name": "mcp-nasa",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server that wraps NASA's public APIs (APOD, Mars Rover Photos, NeoWs, EPIC, DONKI) so an MCP client (Claude Desktop, Claude Code, etc.) can query space data as tools/resources.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx --env-file=.env src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
