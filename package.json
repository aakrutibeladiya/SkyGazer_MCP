{
  "name": "skygazer-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server for space data and stargazing planning: NASA APOD, near-Earth objects, geomagnetic storms/aurora forecasts, JPL asteroid/comet lookups and close approaches, moon phase, and naked-eye planet visibility.",
  "main": "dist/index.js",
  "bin": {
    "skygazer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx --env-file=.env src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nasa",
    "space",
    "astronomy",
    "stargazing",
    "asteroid",
    "claude"
  ],
  "author": "aakrutibeladiya <aakrutibeladiya0@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakrutibeladiya/NASA-MCP.git"
  },
  "homepage": "https://github.com/aakrutibeladiya/NASA-MCP#readme",
  "bugs": {
    "url": "https://github.com/aakrutibeladiya/NASA-MCP/issues"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
